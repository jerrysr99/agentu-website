# Copy to /etc/brief-request.env and replace every placeholder.
# chmod 640, owner root, group www-data. Do not commit filled-in secrets.
# The service reads only this environment. Subscriber state stays in SUBSCRIBERS_PATH.

SUBSCRIBERS_PATH=/srv/briefs/agentu-subscribers.json
REQUEST_LOG=/srv/briefs/brief-requests.jsonl
PDF_DIR=/srv/briefs/pdf

SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
MAIL_FROM=brief@agentu.ai

CONFIRM_SECRET=replace-with-a-long-random-string
PUBLIC_BASE_URL=https://agentu.ai
